# Base de datos
DATABASE_URL="mysql://habit_user:habit_password@localhost:3306/habit_tracker"

# JWT
JWT_SECRET="tu-secreto-super-seguro-cambiame-en-produccion"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# MySQL (si usas Docker)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=habit_tracker
MYSQL_USER=habit_user
MYSQL_PASSWORD=habit_password

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-contrasena-de-app
SMTP_FROM="Habit Tracker <tu-email@gmail.com>"

# Redis (para Bull queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Web Push (VAPID keys - genera con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY="tu-clave-publica-vapid"
VAPID_PRIVATE_KEY="tu-clave-privada-vapid"
VAPID_SUBJECT="mailto:admin@habittracker.com"
